# Copy to .env and replace the placeholders. Never commit .env.

# --- Application ---
NODE_ENV=development
# Port the app listens on when run locally (npm run dev). Inside Docker it is always 3000.
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed origins, or * for any origin
CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret
# 15m is the default; you may raise it locally (e.g. 8h) for manual testing — never in production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Host ports published by docker-compose (change these if they clash with other projects) ---
# Containers still talk to each other on the internal ports (postgres:5432, redis:6379).
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- PostgreSQL (used by docker-compose to initialise the database) ---
# Use URL-safe characters in the password (it is embedded in DATABASE_URL).
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qaryati

# --- Connection URLs for running the app locally (outside Docker) ---
# These go through the host ports above; keep them in sync with POSTGRES_HOST_PORT / REDIS_HOST_PORT.
# docker-compose overrides these to point at the postgres/redis services.
DATABASE_URL=postgresql://change_me:change_me@localhost:5433/qaryati?schema=public
REDIS_URL=redis://localhost:6380

# --- Development seed admin ---
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace_with_a_local_dev_password
