{
  "name": "qaryati-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Qaryati backend API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "perf:data": "tsx --env-file-if-exists=.env k6/data/generate-villages.ts",
    "perf:clean": "tsx --env-file-if-exists=.env k6/data/cleanup-villages.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "^6.19.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
